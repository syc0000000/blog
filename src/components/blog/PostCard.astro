---
import { writingPath, tagSlug } from '../../lib/content';
import { sitePath } from '../../lib/urls';
const { entry } = Astro.props;
const { data } = entry;
---
<article class="post-row">
  <time class="meta" datetime={data.publishedAt.toISOString()}>{data.publishedAt.toLocaleDateString('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' })}</time>
  <div>
    <h3><a href={writingPath(entry)}>{data.title}</a></h3>
    <p>{data.description}</p>
    {data.column && <div class="meta">{data.column}{data.columnOrder ? ` · 第 ${data.columnOrder} 篇` : ''}</div>}
    {data.tags.length > 0 && <div class="tags">{data.tags.map((tag: string) => <a class="tag" href={sitePath(`/tags/${tagSlug(tag)}/`)}>#{tag}</a>)}</div>}
  </div>
</article>
<style>
  .post-row { display:grid; grid-template-columns:8rem 1fr; gap:1rem; padding:1.2rem 0; border-bottom:1px solid var(--line); }
  .post-row h3 { margin:0 0 .2rem; font-size:1.2rem; letter-spacing:-.02em; }
  .post-row h3 a { text-decoration:none; }
  .post-row h3 a:hover { text-decoration:underline; }
  .post-row p { color:var(--muted); margin:.15rem 0; }
  @media (max-width:40rem) { .post-row { grid-template-columns:1fr; gap:.2rem; } }
</style>
