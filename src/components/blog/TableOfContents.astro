---
const { headings = [] } = Astro.props;
---
{headings.length > 0 && <details class="toc"><summary>目录</summary><ol>{headings.map((heading: any) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
<style>
  .toc { margin:2rem 0; border-block:1px solid var(--line); padding:.8rem 0; color:var(--muted); }
  .toc summary { cursor:pointer; color:var(--ink); }
  .toc ol { margin:.8rem 0 0; padding-left:1.3rem; }
  .toc a { color:inherit; }
</style>
