---
import { site } from '../../data/site';
import { navigation } from '../../data/navigation';
import { sitePath } from '../../lib/urls';
import Icon from './Icon.astro';
---
<header class="site-header container">
  <a class="brand" href={sitePath('/')} aria-label={`${site.name} home`}>{site.name}</a>
  <nav aria-label="主导航">
    {navigation.map((item) => <a href={sitePath(item.href)}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    {site.features.search && <a class="icon-action" href={sitePath('/search/')} aria-label="搜索"><Icon name="search" /></a>}
    {site.features.favorites && <a class="icon-action" href={sitePath('/favorites/')} aria-label="收藏"><Icon name="bookmark" /></a>}
    {site.features.theme && <button class="icon-action" data-theme-toggle aria-label="切换主题"><Icon name="theme" /></button>}
  </div>
</header>
<style>
  .site-header { display:flex; align-items:center; gap:2rem; min-height:5rem; border-bottom:1px solid var(--line); }
  .brand { font-weight:800; text-decoration:none; letter-spacing:-.04em; font-size:1.2rem; }
  nav { display:flex; flex-wrap:wrap; gap:1rem; flex:1; }
  nav a { color:var(--muted); text-decoration:none; font-size:.9rem; }
  nav a:hover { color:var(--ink); }
  .header-actions { display:flex; gap:.35rem; align-items:center; }
  .icon-action { display:inline-grid; place-items:center; width:2.25rem; height:2.25rem; padding:0; border:1px solid transparent; border-radius:50%; background:transparent; color:var(--muted); text-decoration:none; cursor:pointer; transition:color .15s ease, border-color .15s ease, background .15s ease; }
  .icon-action:hover { color:var(--ink); border-color:var(--line); background:var(--soft); }
  @media (max-width: 58rem) { .site-header { flex-wrap:wrap; gap:.75rem 1rem; padding:1rem 0; } nav { order:3; flex-basis:100%; overflow-x:auto; flex-wrap:nowrap; padding-bottom:.25rem; } }
</style>
<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme;
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('fourfold-theme', next); } catch { /* storage may be disabled */ }
  });
</script>
