---
import Icon from '../chrome/Icon.astro';
const { id } = Astro.props;
---
<button class="favorite" data-favorite={id} aria-pressed="false"><Icon name="heart" /><span data-favorite-label>收藏</span></button>
<script>
  const key = 'fourfold-favorites';
  const read = () => { try { const v = JSON.parse(localStorage.getItem(key) || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };
  document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
    const id = button.getAttribute('data-favorite');
    const label = button.querySelector<HTMLElement>('[data-favorite-label]');
    const update = () => { const active = read().includes(id); button.setAttribute('aria-pressed', String(active)); if (label) label.textContent = active ? '已收藏' : '收藏'; };
    button.addEventListener('click', () => {
      try {
        const list = read();
        const next = list.includes(id) ? list.filter((item) => item !== id) : [...list, id];
        localStorage.setItem(key, JSON.stringify(next));
        update();
      } catch {
        if (label) label.textContent = '收藏不可用';
      }
    });
    update();
  });
</script>
<style>
  .favorite { display:inline-flex; align-items:center; gap:.4rem; border:1px solid var(--line); border-radius:999px; background:none; padding:.45rem .8rem; cursor:pointer; }
  .favorite[aria-pressed='true'] { color:var(--accent); border-color:var(--accent); }
</style>
