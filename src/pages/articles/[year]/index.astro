---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedWriting, yearOf } from '../../../lib/content';
export async function getStaticPaths(){
  const writing = await getPublishedWriting();
  return [...new Set(writing.map(yearOf))].map((year) => ({ params:{ year:String(year) }, props:{ writing:writing.filter((e)=>yearOf(e)===year) } }));
}
const { year } = Astro.params;
const { writing } = Astro.props;
---
<BaseLayout title={`${year} 年文章 · NBB's Blog`}><header class="page-head container"><p class="eyebrow">Archive</p><h1>{year}</h1><p>{writing.length} 篇</p></header><section class="container list">{writing.map((entry:any)=><PostCard entry={entry}/>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(4rem,12vw,9rem);line-height:.9;letter-spacing:-.07em;margin:.4rem 0}.page-head p{color:var(--muted)}</style>
