---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPublishedCollection } from '../../lib/content';
export async function getStaticPaths(){ const columns=await getPublishedCollection('columns'); return columns.map((column)=>({params:{slug:column.data.slug},props:{column}})); }
const { column }=Astro.props; const entries=(await getPublishedCollection('writing')).filter((entry)=>entry.data.column===column.data.title).sort((a,b)=>(a.data.columnOrder??0)-(b.data.columnOrder??0));
---
<BaseLayout title={`${column.data.title} · NBB's Blog`} description={column.data.description} canonical={column.data.canonical} image={column.data.ogImage}><header class="page-head container"><p class="eyebrow">Column</p><h1>{column.data.title}</h1><p>{column.data.description}</p></header><section class="container list">{entries.map((entry)=><PostCard entry={entry}/>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted);max-width:40rem}</style>
