---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedCollection, columnPath } from '../../lib/content';
import Icon from '../../components/chrome/Icon.astro';
const columns = (await getPublishedCollection('columns')).sort((a,b)=>a.data.order-b.data.order);
const writing = await getPublishedCollection('writing');
---
<BaseLayout title="专栏 · NBB's Blog" description="按推荐顺序组织的连续阅读路径。"><header class="page-head container"><p class="eyebrow">Columns</p><h1>把文章连成路径。</h1><p>专栏是作者策划的连续阅读；标签则用于横向探索。</p></header><section class="container cards">{columns.map((column)=><article><p class="eyebrow">Series {String(column.data.order).padStart(2,'0')}</p><h2><a href={columnPath(column)}>{column.data.title}</a></h2><p>{column.data.description}</p><small>{writing.filter((entry)=>entry.data.column===column.data.title).length} 篇 · 按顺序阅读 <Icon name="arrowRight" size="sm" /></small></article>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.cards article{border-top:1px solid var(--line);padding:1.2rem 0 2rem}.cards h2{margin:.2rem 0;font-size:1.6rem}.cards p{color:var(--muted)}.cards small{color:var(--accent)}@media(max-width:42rem){.cards{grid-template-columns:1fr}}</style>
