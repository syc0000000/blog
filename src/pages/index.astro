---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getPublishedWriting } from '../lib/content';
import { site } from '../data/site';
import { sitePath } from '../lib/urls';
import Icon from '../components/chrome/Icon.astro';
const writing = await getPublishedWriting();
const featured = writing.filter((entry) => entry.data.featured).slice(0, 4);
const recent = writing.slice(0, 5);
---
<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Personal publication</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.description}</p>
    <p class="author">{site.author.name} · {site.author.bio}</p>
  </section>
  <section class="container">
    <div class="section-heading"><h2><span>01 /</span> 写作</h2><a href={sitePath('/writing/')}>全部 {writing.length} 篇 <Icon name="arrowRight" size="sm" /></a></div>
    {featured.length > 0 && <><p class="eyebrow sub">精选</p><div class="list">{featured.map((entry) => <PostCard entry={entry} />)}</div></>}
    <p class="eyebrow sub">最近更新</p><div class="list">{recent.map((entry) => <PostCard entry={entry} />)}</div>
  </section>
</BaseLayout>
<style>
  .hero { padding:clamp(4rem,10vw,9rem) 0 5rem; }
  .hero h1 { font-size:clamp(4rem,15vw,10rem); line-height:.85; margin:.5rem 0 1.5rem; letter-spacing:-.08em; }
  .lede { font-size:clamp(1.4rem,3vw,2.2rem); max-width:45rem; line-height:1.25; }
  .author { color:var(--muted); max-width:40rem; }
  .section-heading span { color:var(--accent); font-size:.8rem; font-family:ui-monospace,monospace; }
  .sub { margin-top:2rem; }
  @media(max-width:48rem){.hero{padding-top:4rem}}
</style>
