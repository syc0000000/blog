---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getPublishedWriting, tagSlug } from '../../lib/content';
export async function getStaticPaths(){ const writing=await getPublishedWriting(); const tags=[...new Set(writing.flatMap((e)=>e.data.tags))]; return tags.map((tag)=>({params:{tag:tagSlug(tag)},props:{tag,entries:writing.filter((e)=>e.data.tags.includes(tag))}})); }
const {tag,entries}=Astro.props;
---
<BaseLayout title={`#${tag} · NBB's Blog`}><header class="page-head container"><p class="eyebrow">Tag</p><h1>#{tag}</h1><p>{entries.length} 篇文章</p></header><section class="container list">{entries.map((entry)=><PostCard entry={entry}/>)}</section></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(3rem,10vw,7rem);line-height:.9;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}</style>
