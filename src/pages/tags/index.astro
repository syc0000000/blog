---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/urls';
import { getPublishedWriting, getTags, tagSlug } from '../../lib/content';
const writing=await getPublishedWriting(); const tags=getTags(writing);
---
<BaseLayout title="标签 · NBB's Blog" description="按主题横向探索文章。"><header class="page-head container"><p class="eyebrow">Tags</p><h1>从一个词开始。</h1><p>共 {tags.length} 个主题入口。</p></header><div class="container tag-cloud">{tags.map(([tag,count])=><a href={sitePath(`/tags/${tagSlug(tag)}/`)}>#{tag} <sup>{count}</sup></a>)}</div></BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.tag-cloud{display:flex;flex-wrap:wrap;gap:.8rem 1.2rem;border-top:1px solid var(--line);padding-top:2rem}.tag-cloud a{font-size:1.2rem;color:var(--accent)}.tag-cloud sup{font-size:.7em;color:var(--muted)}</style>
