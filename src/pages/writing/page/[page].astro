---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import { getPublishedWriting } from '../../../lib/content';
import { site } from '../../../data/site';
export async function getStaticPaths() {
  const writing = await getPublishedWriting();
  const total = Math.max(1, Math.ceil(writing.length / site.writingPageSize));
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: { pageEntries: writing.slice((page - 1) * site.writingPageSize, page * site.writingPageSize), totalPages: total, currentPage: page },
    };
  });
}
const { pageEntries, totalPages, currentPage } = Astro.props;
---
<BaseLayout title={`写作 · 第 ${currentPage} 页 · NBB's Blog`} description="全部文章与年份归档。">
  <header class="page-head container"><p class="eyebrow">Articles</p><h1>文章 · 第 {currentPage} 页</h1><p>按最近发布或更新排序。</p></header>
  <section class="container list">{pageEntries.map((entry: any) => <PostCard entry={entry} />)}</section>
  <div class="container"><Pagination current={currentPage} total={totalPages} base="/writing" /></div>
</BaseLayout>
<style>.page-head{padding:5rem 0 2rem}.page-head h1{font-size:clamp(2.8rem,7vw,5.5rem);line-height:1.02;letter-spacing:-.06em;max-width:55rem;margin:.5rem 0}.page-head p{color:var(--muted)}</style>
